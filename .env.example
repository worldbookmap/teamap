# ── 관리자 ─────────────────────────────────────────────
# 차 등록/수정/삭제용 비밀번호. 로컬에서 비워두면 로그인 없이 편집할 수 있습니다 (배포 시 필수).
ADMIN_PASSWORD=
# (선택) 쿠키 서명 키. 비우면 ADMIN_PASSWORD 를 사용합니다.
ADMIN_SECRET=

# ── Supabase ──────────────────────────────────────────
# 둘 다 비워두면 로컬 파일 저장소(.data/)를 사용합니다.
# Supabase 대시보드 → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
